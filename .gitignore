# WARNING: ignored experiment data is not backed up by Git.
# Never run `git clean -fdx` or `git clean -fdX` from this repository.
# Use `git clean -fd` or an explicit disposable path.

# Host-local data and generated outputs
data/
results/
wandb/
**/logs/
mlruns/
next_phase_artifacts/

# Downloaded third-party payloads; keep lightweight metadata and setup helpers
external_resources/*
!external_resources/README.md
!external_resources/setup_h200_external_env.sh
!external_resources/manifests/
external_resources/manifests/*
!external_resources/manifests/*.md
!external_resources/manifests/interpretability_transfer_resources.json
!external_resources/manifests/related_work_sources.json

# Frozen provenance is external; do not recreate it in the live checkout
archive/

# Retired live-root names must not be resurrected
Research1/
Research2/
ProteinInterpret/
benchmark_encoder/
paper_r2_nature_mi/
r2_decoder_sparse_readout_audit/
project_records/

# Credentials and private agent state
.env
.env.*
!.env.local.example
.claude/

# Python caches and environments
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
.conda/
*.egg-info/

